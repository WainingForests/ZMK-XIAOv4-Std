#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        WtoTabLeft: WtoTabLeft {
            compatible = "zmk,behavior-mod-morph";
            label = "WTOTABLEFT";
            bindings = <&kp W>, <&kp LC(PAGE_UP)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        PtoTabRight: PtoTabRight {
            compatible = "zmk,behavior-mod-morph";
            label = "PTOTABRIGHT";
            bindings = <&kp P>, <&kp LC(PAGE_DOWN)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        warpd {
            bindings = <&kp LG(LC(LS(Z)))>;
            key-positions = <30 33>;
            timeout-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 5 Q                     &WtoTabLeft  &kp F            &PtoTabRight      &kp G                  &kp J                   &kp L              &kp U                &kp Y    &lt 5 SEMICOLON
&lt 3 A                     &kp R        &hm LEFT_ALT S   &hm LEFT_SHIFT T  &kp D                  &kp H                   &hm RIGHT_SHIFT N  &hm LEFT_ALT E       &kp I    &lt 4 O
&hm LS(LA(LC(LEFT_GUI))) Z  &kp X        &hm LA(LCTRL) C  &hm LCTRL V       &hm LS(LCTRL) B        &hm LS(LCTRL) K         &hm LCTRL M        &hm LA(LCTRL) COMMA  &kp DOT  &hm LS(LA(LC(LEFT_GUI))) SLASH
                                                          &lt 1 SPACE       &hm LEFT_GUI ESCAPE    &hm LEFT_GUI BACKSPACE  &lt 2 ENTER
            >;
        };

        navigation {
            bindings = <
&none  &none  &none         &none           &none                   &kp HOME        &kp LC(LEFT_ARROW)  &kp LC(RIGHT)  &kp END          &msc SCRL_UP
&none  &none  &kp LEFT_ALT  &kp LEFT_SHIFT  &none                   &kp LEFT        &kp DOWN            &kp UP_ARROW   &kp RIGHT        &kp SINGLE_QUOTE
&none  &none  &none         &kp LCTRL       &kp LS(LEFT_CONTROL)    &mmv MOVE_LEFT  &mmv MOVE_DOWN      &mmv MOVE_UP   &mmv MOVE_RIGHT  &msc SCRL_DOWN
                            &trans          &trans                  &mkp RCLK       &mkp LCLK
            >;
        };

        numbers {
            bindings = <
&kp GRAVE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3       &kp EQUAL          &none                 &none            &none         &none         &none
&kp TAB        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6       &kp NUMBER_0       &none                 &kp RIGHT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT  &none
&kp BACKSLASH  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9       &kp MINUS          &kp LS(LEFT_CONTROL)  &kp LCTRL        &none         &none         &none
                                           &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &trans                &trans
            >;
        };

        parenthesis {
            bindings = <
&none  &none         &none         &none           &none            &kp C_NEXT        &kp LBRC              &kp RBRC               &kp CAPSLOCK     &kp PAGE_UP
&none  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &none            &kp C_PLAY_PAUSE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PRINTSCREEN  &kp DELETE
&none  &none         &none         &kp LCTRL       &kp LS(LCTRL)    &kp C_PREVIOUS    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none            &kp PAGE_DOWN
                                   &none           &none            &none             &none
            >;
        };

        function_layer {
            bindings = <
&none  &kp F1  &kp F2  &kp F3  &kp C_BRIGHTNESS_INC    &none          &none           &none         &none         &none
&none  &kp F4  &kp F5  &kp F6  &kp F10                 &none          &kp LEFT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT  &none
&none  &kp F7  &kp F8  &kp F9  &kp C_BRIGHTNESS_DEC    &kp LS(LCTRL)  &kp LCTRL       &none         &none         &none
                       &none   &none                   &none          &none
            >;
        };

        config {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &none        &none   &none  &none  &none
&none         &none         &none         &bt BT_CLR    &bt BT_CLR_ALL    &none        &none   &none  &none  &none
&none         &none         &none         &none         &bootloader       &bootloader  &none   &none  &none  &none
                                          &trans        &trans            &trans       &trans
            >;
        };
    };
};
