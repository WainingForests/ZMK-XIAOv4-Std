#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        WtoTabLeft: WtoTabLeft {
            compatible = "zmk,behavior-mod-morph";
            label = "WTOTABLEFT";
            bindings = <&kp W>, <&kp LC(PAGE_UP)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        RtoTabRight: RtoTabRight {
            compatible = "zmk,behavior-mod-morph";
            label = "RTOTABRIGHT";
            bindings = <&kp R>, <&kp LC(PAGE_DOWN)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        leftcurly {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <3 6>;
            timeout-ms = <20>;
        };

        rightbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <2 7>;
            timeout-ms = <20>;
        };

        leftparenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <13 16>;
            timeout-ms = <20>;
        };

        rightparenthersis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <12 17>;
            timeout-ms = <20>;
        };

        leftbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <23 26>;
            timeout-ms = <20>;
        };

        rightbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <22 27>;
            timeout-ms = <20>;
        };

        warpd {
            bindings = <&kp LG(LA(Z))>;
            key-positions = <30 33>;
            timeout-ms = <20>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <2 3>;
            timeout-ms = <20>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
            timeout-ms = <20>;
        };

        tik {
            bindings = <&kp GRAVE>;
            key-positions = <22 23>;
            timeout-ms = <20>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <6 7>;
            timeout-ms = <20>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <16 17>;
            timeout-ms = <20>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 27>;
            timeout-ms = <20>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <31 32>;
            timeout-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &WtoTabLeft  &kp E        &RtoTabRight      &kp T                  &kp Y                   &kp U              &kp I        &kp O    &kp P
&kp A    &kp S        &hm LCTRL D  &hm LEFT_SHIFT F  &kp G                  &kp H                   &hm RIGHT_SHIFT J  &hm LCTRL K  &kp L    &lt 4 SEMICOLON
&lt 3 Z  &kp X        &kp C        &hm LEFT_GUI V    &hm LS(LEFT_GUI) B     &hm LS(LEFT_GUI) N      &hm RIGHT_GUI M    &kp COMMA    &kp DOT  &lt 3 SLASH
                                   &lt 1 SPACE       &hm LEFT_ALT ESCAPE    &hm LEFT_ALT BACKSPACE  &lt 2 ENTER
            >;
        };

        layer_1 {
            bindings = <
&none  &none  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none                   &kp LG(LEFT)    &kp LA(LEFT_ARROW)  &kp LA(RIGHT)  &kp LG(RIGHT)    &none
&none  &none  &kp LEFT_ALT          &kp LEFT_SHIFT        &none                   &kp LEFT        &kp DOWN            &kp UP_ARROW   &kp RIGHT        &msc SCRL_UP
&none  &none  &none                 &kp LCTRL             &kp LS(LEFT_CONTROL)    &mmv MOVE_LEFT  &mmv MOVE_DOWN      &mmv MOVE_UP   &mmv MOVE_RIGHT  &msc SCRL_DOWN
                                    &trans                &trans                  &mkp RCLK       &mkp LCLK
            >;
        };

        layer_2 {
            bindings = <
&kp C_PREV        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp C_VOLUME_UP      &none                 &none            &none         &none  &none
&kp C_NEXT        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0         &none                 &kp RIGHT_SHIFT  &kp LEFT_ALT  &none  &none
&kp C_PLAY_PAUSE  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp C_VOLUME_DOWN    &kp LS(LEFT_CONTROL)  &kp LCTRL        &none         &none  &none
                                              &none         &kp C_MUTE           &trans                &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &none        &none   &none  &none  &none
&none         &none         &none         &bt BT_CLR    &bt BT_CLR_ALL    &none        &none   &none  &none  &none
&none         &none         &none         &none         &bootloader       &bootloader  &none   &none  &none  &none
                                          &trans        &trans            &trans       &trans
            >;
        };

        function_layer {
            bindings = <
&none  &kp F1  &kp F2  &kp F3  &none    &none  &none      &none         &none         &none
&none  &kp F4  &kp F5  &kp F6  &none    &none  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &none
&none  &kp F7  &kp F8  &kp F9  &none    &none  &none      &none         &none         &none
                       &none   &none    &none  &none
            >;
        };
    };
};
