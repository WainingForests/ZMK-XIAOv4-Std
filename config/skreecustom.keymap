#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3     &kp N4     &kp N5      &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp EQUAL    &kp Q     &kp W     &kp E        &kp LBKT  &kp RBKT  &kp EQUAL  &kp BSPC
&kp TAB    &kp N1  &kp W   &kp E      &kp R      &kp T       &kp Y   &kp U     &kp I      &kp O    &kp P     &kp MINUS    &kp A     &kp S     &kp D        &kp F     &kp FSLH  &kp STAR   &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D      &kp F      &kp G       &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp SQT      &kp Z     &kp X     &kp C        &kp N7    &kp N8    &kp N9     &kp PLUS
&kp GRAVE  &kp Z   &kp X   &kp C      &kp V      &kp B       &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH                                      &kp N4    &kp N5    &kp N6     &kp TAB
                                                                                                                                    &kp UP                 &kp N1    &kp N2    &kp N3     &kp RET
                                                                                                                          &kp LEFT  &kp DOWN  &kp RIGHT    &kp N0              &kp DOT
                           &kp LSHFT  &kp SPACE  &kp BSPC                      &kp RET
                           &kp LCTRL  &kp LALT   &kp N1      &kp N2  &kp RALT  &kp RGUI
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans
                                                                                                            &trans            &trans  &trans  &trans  &trans
                                                                                                    &trans  &trans  &trans    &trans          &trans
                        &trans  &trans  &trans                    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans
                                                                                                            &trans            &trans  &trans  &trans  &trans
                                                                                                    &trans  &trans  &trans    &trans          &trans
                        &trans  &trans  &trans                    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans
                                                                                                            &trans            &trans  &trans  &trans  &trans
                                                                                                    &trans  &trans  &trans    &trans          &trans
                        &trans  &trans  &trans                    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
