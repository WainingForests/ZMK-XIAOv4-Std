//#include <behaviors/mouse_keys.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        leftcurly {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <3 6>;
        };

        rightbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <2 7>;
        };

        leftparenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <13 16>;
        };

        rightparenthersis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <12 17>;
        };

        leftbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <23 26>;
        };

        rightbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <22 27>;
        };

        warpd {
            bindings = <&kp LA(LG(Z))>;
            key-positions = <30 33>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <31 32>;
        };

        tableft {
            bindings = <&kp LC(LS(TAB))>;
            key-positions = <11 12>;
            timeout-ms = <30>;
        };

        tabright {
            bindings = <&kp LC(TAB)>;
            key-positions = <17 18>;
            timeout-ms = <30>;
        };

        movetableft {
            bindings = <&kp LS(LC(PAGE_UP))>;
            key-positions = <21 22>;
            timeout-ms = <30>;
        };

        movetabright {
            bindings = <&kp LC(LS(PAGE_DOWN))>;
            key-positions = <27 28>;
            timeout-ms = <30>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <2 3>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        tik {
            bindings = <&kp GRAVE>;
            key-positions = <22 23>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <6 7>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <16 17>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp W  &kp F        &kp P             &kp B                  &kp J                    &kp L              &kp U        &kp Y    &kp SEMICOLON
&kp A    &kp R  &hm LCTRL S  &hm LEFT_SHIFT T  &kp G                  &kp M                    &hm RIGHT_SHIFT N  &hm RCTRL E  &kp I    &kp O
&lt 3 Z  &kp X  &kp C        &hm LCMD D        &hm LS(LCMD) V         &hm RS(RIGHT_GUI) K      &hm RCMD H         &kp COMMA    &kp DOT  &lt 3 SLASH
                             &lt 1 SPACE       &hm LEFT_ALT ESCAPE    &hm RIGHT_ALT BACKSPACE  &lt 2 ENTER
            >;
        };

        layer_1 {
            bindings = <
&none  &none  &none      &none           &none     &kp LG(LEFT)    &kp LA(LEFT_ARROW)  &kp LA(RIGHT)  &kp LG(RIGHT)    &none
&none  &none  &kp LCTRL  &kp LEFT_SHIFT  &none     &kp LEFT        &kp DOWN            &kp UP_ARROW   &kp RIGHT        &msc SCRL_UP
&none  &none  &none      &kp LCMD        &none     &mmv MOVE_LEFT  &mmv MOVE_DOWN      &mmv MOVE_UP   &mmv MOVE_RIGHT  &msc SCRL_DOWN
                         &trans          &trans    &kp DELETE      &trans
            >;
        };

        layer_2 {
            bindings = <
&kp C_PREV        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp C_VOLUME_UP      &none   &none            &none      &none  &none
&kp C_NEXT        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0         &none   &kp RIGHT_SHIFT  &kp RCTRL  &none  &none
&kp C_PLAY_PAUSE  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp C_VOLUME_DOWN    &none   &kp RCMD         &none      &none  &none
                                              &kp C_MUTE    &trans               &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &none        &none   &none  &none  &none
&none         &none         &none         &bt BT_CLR    &bt BT_CLR_ALL    &none        &none   &none  &none  &none
&none         &none         &none         &none         &bootloader       &bootloader  &none   &none  &none  &none
                                          &trans        &trans            &trans       &trans
            >;
        };
    };
};
