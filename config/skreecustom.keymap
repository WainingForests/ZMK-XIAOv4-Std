//#include <behaviors/mouse_keys.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp F        &kp P             &kp B                  &kp J                    &kp L              &kp U        &kp Y    &kp SEMICOLON
&kp A  &kp R  &hm LCTRL S  &hm LEFT_SHIFT T  &kp G                  &kp M                    &hm RIGHT_SHIFT N  &hm RCTRL E  &kp I    &kp O
&kp Z  &kp X  &kp C        &hm LCMD D        &kp V                  &kp K                    &hm RCMD H         &kp COMMA    &kp DOT  &kp FSLH
                           &lt 1 SPACE       &hm LEFT_ALT ESCAPE    &hm RIGHT_ALT BACKSPACE  &lt 2 ENTER
            >;
        };

        layer_1 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &trans  &trans  &trans  &trans  &trans
&studio_unlock  &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
                                            &trans        &bootloader     &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans
                        &trans  &trans    &bootloader  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans
                        &trans  &trans    &bootloader  &trans
            >;
        };
    };
};
